{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "dev-web-cmngrd-share",
    "public": "public",
    "ignore": ["firebase.json", "firebase.prod.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "dev-web-cmngrd-share",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}
