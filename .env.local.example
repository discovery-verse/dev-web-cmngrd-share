# Copy to .env.local.
#
# LOCAL / DEMO (emulators): set NEXT_PUBLIC_USE_EMULATORS=1 — the app then uses
# the built-in demo config and the local emulators; the values below are ignored
# and NEXT_PUBLIC_FIRESTORE_DB_ID should stay UNSET (uses the (default) database).
#
# PRODUCTION: leave NEXT_PUBLIC_USE_EMULATORS unset/0 and fill in the values
# below (Firebase console → Project settings → Your apps). Leave
# NEXT_PUBLIC_FIRESTORE_DB_ID unset to use the (default) database. See SETUP.md.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional named Firestore database. Leave UNSET for the (default) database.
NEXT_PUBLIC_FIRESTORE_DB_ID=

# Set to 1 to run entirely against the local Firebase emulators.
NEXT_PUBLIC_USE_EMULATORS=

# Used by scripts/seed.mjs (server-side only, never shipped to the client).
# Path to a service-account JSON key with Firestore access. Do not commit the key.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Storage bucket the Admin SDK writes to (admin media library + room-cover
# uploads via /api/admin/media). Optional — defaults to
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET. The Cloud Run runtime service account
# needs roles/storage.objectAdmin on this bucket.
FIREBASE_STORAGE_BUCKET=
